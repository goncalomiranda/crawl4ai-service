[Unit]
Description=Crawl4AI API Service
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment="PATH=__VENV_DIR__/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/etc/crawl4ai/crawler-api.env
ExecStart=__VENV_DIR__/bin/uvicorn crawler_api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
